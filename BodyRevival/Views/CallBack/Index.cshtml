@using BodyRevival.Models
@model Communication
@{
    ViewData["Title"] = "Index";
}
<section class="breadcrumb-section set-bg" data-setbg="img/breadcrumb-bg.jpg">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="breadcrumb-text">
                    <h2>Contact Us</h2>
                    <div class="bt-option">
                        <a href="./index.html">Home</a>
                        <a href="#">Pages</a>
                        <span>Contact us</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Breadcrumb Section End -->
<!-- Contact Section Begin -->
<section class="contact-section spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-6">
                <div class="leave-comment">
                    <form method="post" asp-action="SendMessage">
                        <input asp-for="Name" type="text" placeholder="Name">
                        <input asp-for="Number" type="text" placeholder="Number">
                        <input asp-for="Subject" type="text" placeholder="Subject">
                        <textarea asp-for="Question" placeholder="Comment"></textarea>
                        <button type="submit">Send</button>
                    </form>
                </div>
            </div>
            <div class="col-lg-6">
                <img src="~/img/about-us.jpg" />
            </div>
        </div>
        <div class="map">
            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3034.448291768389!2d49.851913196429216!3d40.38920433674722!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNDAuMzg5MjA0MzM2NzQ3MjIsIDQ5Ljg1MTkxMzE5NjQyOTIxNg!5e0!3m2!1sen!2sbd!4v1581710470843!5m2!1sen!2sbd"
                    height="550" style="border:0;" allowfullscreen=""></iframe>
        </div>

    </div>
</section>