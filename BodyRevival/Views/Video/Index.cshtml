@using BodyRevival.Models
@model List<Videos>
@{
    ViewData["Title"] = "Index";
}
<section class="breadcrumb-section set-bg" data-setbg="img/breadcrumb-bg.jpg">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="breadcrumb-text">
                    <h2>Videos</h2>
                    <div class="bt-option">
                        <span>Video</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- ChoseUs Section End -->
<!-- About US Section Begin -->
<style>
    /* Özel stil tanımı */
    .aboutus-section .row:not(:last-child) {
        margin-bottom: 20px; /* Row'ların alt boşluğunu 20 piksel olarak ayarlar */
    }
</style>

<section class="aboutus-section">
    @foreach (var item in Model)
    {

        <div class="container-fluid">
            <div class="row" style="margin-bottom: 0%;">
                <div class="col-lg-6 p-0">
                    <div class="about-video set-bg" style="background-color: #000;height: 400px;">
                       @Html.Raw(item.VideoLink)
                    </div>
                </div>
                <div class="col-lg-6 p-0">
                    <div class="about-text" style="height: 400px;">
                        <div class="section-title">
                            <h2>@item.Title</h2>
                        </div>
                        <div class="at-desc">
                            <p>
                                @item.Description
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</section>

<!-- About US Section End -->
<!-- Get In Touch Section Begin -->
