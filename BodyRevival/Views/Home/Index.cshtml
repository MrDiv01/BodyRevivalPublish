<!-- Team Section Begin -->
<section class="team-section spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="team-title">
                    <div class="section-title">
                        <span>Our Team</span>
                        <h2>TRAIN WITH EXPERTS</h2>
                    </div>
                    <a asp-action="Index" asp-controller="Team" class="primary-btn btn-normal appoinment-btn">appointment</a>
                </div>
            </div>
        </div>
        <div class="row">
            @if (Model.teachers.Count > 3)
            {
                <div class="ts-slider owl-carousel">
                    @foreach (var trainer in Model.teachers)
                    {
                        <div class="col-lg-4">
                            <div class="ts-item set-bg" data-setbg="uploads/@trainer.Image">
                                <div class="ts_text">
                                    <h4>@trainer.User.FullName</h4>
                                    <span>Gym Trainer</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                foreach (var trainer in Model.teachers)
                {
                    <div class="col-lg-4">
                        <div class="ts-item set-bg" data-setbg="uploads/@trainer.Image">
                            <div class="ts_text">
                                <h4>@trainer.User.FullName</h4>
                                <span>@trainer.Speciality</span><span>Trainer</span>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>
<style>
    /* Basic reset */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

/* Hero section styling */
.hero-section {
    position: relative;
    overflow: hidden;
}

.hs-slider .hs-item {
    position: relative;
    height: 100vh; /* Full viewport height */
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
}

.hs-slider .hs-item .hi-text {
    text-align: center;
    color: #fff;
    max-width: 600px;
}

.hs-slider .hi-text span {
    display: block;
    font-size: 24px;
    margin-bottom: 10px;
}

.hs-slider .hi-text h1 {
    font-size: 48px;
    margin-bottom: 20px;
}

.hs-slider .primary-btn {
    background-color: #ff5722;
    color: #fff;
    padding: 10px 20px;
    text-decoration: none;
    border-radius: 5px;
    font-size: 16px;
}

media (max-width: 768px) {
    .hs-slider .hs-item {
        height: 50vh; /* Reduce height on smaller screens */
    }

    .hs-slider .hi-text h1 {
        font-size: 36px;
    }

    .hs-slider .hi-text span {
        font-size: 18px;
    }

    .hs-slider .primary-btn {
        font-size: 14px;
        padding: 8px 16px;
    }
}

</style>