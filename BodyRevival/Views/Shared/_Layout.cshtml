                <li><a asp-action="Index" asp-controller="Contact">Contact</a></li>
                <li><a asp-action="Index" asp-controller="Video">Videos</a></li>

            </ul>
        </nav>
        <div id="mobile-menu-wrap"></div>
        <div class="canvas-social">
            @if (User.Identity.IsAuthenticated)
            {
                <a asp-action="Logout" asp-controller="Login"><i class="fa-solid fa-right-to-bracket"></i></a>
            }
            else
            {
                <a asp-action="index" asp-controller="Login"><i class="fa-solid fa-user-plus"></i></a>

            }
            <a href="#"><i class="fa fa-facebook"></i></a>
            <a href="#"><i class="fa fa-twitter"></i></a>
            <a href="#"><i class="fa fa-youtube-play"></i></a>
            <a href="#"><i class="fa fa-instagram"></i></a>
        </div>
    </div>
