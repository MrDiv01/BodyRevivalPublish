@using BodyRevival.Models
@model HomeSlider
@{
    ViewData["Title"] = "Update";
}
<div class="container" style="margin-top:5%">
    <form method="post" asp-action="Update" asp-controller="SliderManage" enctype="multipart/form-data">
        <div class="form-group">
            <label asp-for="FirstMotivationWord">FirstMotivationWord</label>
            <input asp-for="FirstMotivationWord" class="form-control" placeholder="FirstMotivationWord">
        </div>
        <span asp-validation-for="FirstMotivationWord" class="text-danger"></span>

        <div class="form-group">
            <label asp-for="SecondMotivationWord">SecondMotivationWord</label>
            <input asp-for="SecondMotivationWord" class="form-control" placeholder="SecondMotivationWord">
        </div>
        <span asp-validation-for="SecondMotivationWord" class="text-danger"></span>

        <div class="form-group">
            <label asp-for="ButtonText">ButtonText</label>
            <input asp-for="ButtonText" class="form-control" placeholder="ButtonText">
        </div>
        <span asp-validation-for="ImageFile" class="text-danger"></span>

        <div class="form-group">
            <label asp-for="ButtonUrl">ButtonUrl</label>
            <input asp-for="ButtonUrl" class="form-control" placeholder="ButtonUrl">
        </div>
        <span asp-validation-for="ButtonUrl" class="text-danger"></span> 
        <div class="form-group">
            <label asp-for="ImageFile">Images</label>
            <input asp-for="ImageFile" class="form-control" placeholder="Image">
        </div>
        <span asp-validation-for="ImageFile" class="text-danger"></span>
        <a><button type="submit" class="btn btn-primary">Submit</button></a>
    </form>
</div>