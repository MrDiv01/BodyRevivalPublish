@using BodyRevival.Models
@model Packet
@{
    ViewData["Title"] = "Create";
}
<div class="container" style="margin-top:5%">
    <form method="post" asp-action="Create" enctype="multipart/form-data">
        <div class="form-group">
            <label asp-for="Name">Name</label>
            <input asp-for="Name" class="form-control" placeholder="Name">
        </div>
        <span asp-validation-for="Name" class="text-danger"></span>

        <div class="form-group">
            <label asp-for="Titile">Titile</label>
            <input asp-for="Titile" class="form-control" placeholder="Titile">
        </div>
        <span asp-validation-for="Titile" class="text-danger"></span>

        <div class="form-group">
            <label asp-for="Description">Description</label>
            <input asp-for="Description" class="form-control" placeholder="Description">
        </div>
        <span asp-validation-for="Description" class="text-danger"></span>

        <div class="form-group">
            <label asp-for="AttenDance">AttenDance</label>
            <input asp-for="AttenDance" class="form-control" type="number" placeholder="AttenDance">
        </div>
        <span asp-validation-for="AttenDance" class="text-danger"></span>

        <div class="statbox widget box box-shadow">
            <div class="widget-content widget-content-area">
                <select asp-for="TeacherId" class="selectpicker">
                    @foreach (Teacher item in ViewBag.teachers)
                    {
                    <option value="@item.Id">@item.User.FullName</option>
                    }
                </select>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="ImageFile">ImagesFile</label>
            <input asp-for="ImageFile" class="form-control" placeholder="Image">
        </div>
        <span asp-validation-for="ImageFile" class="text-danger"></span>
        <button type="submit" class="btn btn-primary">Submit</button>
    </form>
</div>