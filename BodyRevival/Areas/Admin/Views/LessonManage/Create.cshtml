@model Lesson
@{
    ViewData["Title"] = "Create";
}

<div class="container" style="margin-top:5%">
    <form id="lessonForm" enctype="multipart/form-data" method="post" asp-action="Create">
        <div class="form-group">
            <label asp-for="Name">Name</label>
            <input asp-for="Name" id="nameInput" class="form-control" placeholder="Name">
        </div>
        <span asp-validation-for="Name" class="text-danger"></span>

        <div class="form-group">
            <label asp-for="Duration">Duration</label>
            <input asp-for="Duration" id="durationInput" class="form-control" placeholder="Duration">
        </div>
        <span asp-validation-for="Duration" class="text-danger"></span>

        <div class="form-group">
            <label asp-for="Cost">Cost</label>
            <input asp-for="Cost" id="costInput" class="form-control" placeholder="Cost">
        </div>
        <span asp-validation-for="Cost" class="text-danger"></span>

        <div class="form-group">
            <label asp-for="Details">Details</label>
            <input asp-for="Details" class="form-control" placeholder="Details">
        </div>
        <span asp-validation-for="Details" class="text-danger"></span>

        <button type="submit" id="submitButton" class="btn btn-primary">Submit</button>
    </form>
</div>
