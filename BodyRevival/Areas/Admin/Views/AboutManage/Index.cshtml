@using BodyRevival.Models
@model About
@{
    ViewData["Title"] = "Index";
}
<div id="tableFooter" class="col-lg-10 col-10 layout-spacing" style="margin-left:10%;margin-top:5%">
    <div class="statbox widget box box-shadow">
        <div class="widget-header">
            <div class="row">
                <div class="col-xl-12 col-md-12 col-sm-12 col-12">
                    <h4>Table with Footer</h4>
                </div>
            </div>
        </div>
        <div class="widget-content widget-content-area">
            <div class="table-responsive">
                <table class="table table-bordered table-hover table-condensed mb-4">
                    <a asp-action="Create" class="btn btn-primary mb-2">Create</a>
                    <thead>
                        <tr>
                            <th>video</th>
                            <th>Discription</th>
                            <th>Title</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                            <tr>
                                <td>@Model.VideoUrl</td>
                                <td>@Model.Title</td>
                                <td>@Model.Description</td>
                                <td class="text-center">
                                    <ul class="table-controls">
                                        <li style="list-style:none"><a asp-action="Update" class="btn btn-warning mb-2">Update</a></li>
                                    </ul>
                                </td>
                            </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

