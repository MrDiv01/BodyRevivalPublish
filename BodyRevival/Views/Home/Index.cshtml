@using BodyRevival.ViewModels
@model HomeViewModel
@{
    ViewData["Title"] = "Index";
}
<section class="hero-section">
    <div class="hs-slider owl-carousel">
        @foreach (var item in Model.slider)
        {
            <div class="hs-item set-bg" data-setbg="uploads/@item.Image">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-6 offset-lg-6">
                            <div class="hi-text">
                                <span>@item.FirstMotivationWord</span>
                                <h1>@item.SecondMotivationWord</h1>
                                <a href="@item.ButtonUrl" class="primary-btn">@item.ButtonText</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<!-- Hero Section End -->
